NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/affiliate_middleware
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
JWT_ISSUER=affiliate-middleware
JWT_AUDIENCE=affiliate-middleware-admin
AUTH_COOKIE_NAME=admin_access_token
REQUEST_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
REDIS_URL=redis://localhost:6379
QUEUES_ENABLED=false
QUEUE_WORKER_CONCURRENCY=5
ADVERTISER_SCRIPT_URL=https://api.chefrecipes.net/api/v1/foodigo/sa/getscript
ADVERTISER_SCRIPT_API_KEY=
ADVERTISER_TLS_REJECT_UNAUTHORIZED=true
ADVERTISER_SUBSCRIPTION_URL=https://api.chefrecipes.net/api/v1/foodigo/sa/stcsubscribe
ADVERTISER_SUBSCRIPTION_API_KEY=
ADVERTISER_NETWORK_NAME=test
POSTBACK_SIGNATURE_SECRET=

# Product routing: partner APIs send productId. Product 1 uses the advertiser values above.
# Add future products in src/services/advertiserProductResolver.js.

# Required only while running `npm run seed:admin --workspace backend`.
INITIAL_ADMIN_NAME=System Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
